# Required for real calls. Get it from platform.bolna.ai -> Developers.
BOLNA_API_KEY=
# Written by `npm run setup-agent`.
BOLNA_AGENT_ID=
# Public https URL of this server, no trailing slash (tunnel or host).
PUBLIC_URL=
# Purchased Bolna number, E.164. Blank uses the account default.
BOLNA_FROM_NUMBER=
# Required once PUBLIC_URL is set. Username is "admin".
DASHBOARD_PASSWORD=
# sarvam (default, English and Hindi) or default (Bolna quickstart providers, English only).
VOICE_PROFILE=sarvam
PORT=3000
# Generated automatically on first start. Keep it fixed in hosted deployments.
TOOL_TOKEN=
