# Required for real calls. Get it from platform.bolna.ai -> Developers.
BOLNA_API_KEY=
# Written by `npm run setup-agent`.
BOLNA_AGENT_ID=
# Public https URL of this server, no trailing slash (tunnel or host).
PUBLIC_URL=
# Purchased Bolna number, E.164. Blank uses the account default.
BOLNA_FROM_NUMBER=
# Set before exposing the dashboard publicly. Username is "admin".
DASHBOARD_PASSWORD=
# sarvam (default, Hindi-English) or default (Bolna quickstart providers).
VOICE_PROFILE=sarvam
PORT=3000
# Generated automatically on first start.
TOOL_TOKEN=
